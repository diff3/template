# PyPandariaEmu Docker defaults

TIMEZONE=Europe/Stockholm

CONTAINER_NAME=pypandaria
IMAGE_NAME=pypandaria
PYTHON_IMAGE=python:3.14-slim-trixie
IMAGE_TAG=py314-trixie
ADMIN_PANEL_PYTHON_IMAGE=python:3.12-slim-bookworm
ADMIN_PANEL_IMAGE_TAG=py312-slim
ADMIN_PANEL_PORT=5001

# Runtime config lives in ../config. The Docker setup only keeps Docker-specific
# image/container settings here.

# Optional host path for the DBC mount used by worldserver.
DBC_HOST_PATH=/home/magnus/docker/SkyFire_548_docker/app/data/dbc
